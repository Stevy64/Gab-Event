# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,nginx
# Production example:
# DEBUG=False
# ALLOWED_HOSTS=votrecompte.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://votrecompte.pythonanywhere.com

# Paiement — mock en local, SingPay dès que les clés sont renseignées
ALLOW_MOCK_PAYMENTS=True
# PAYMENT_PROVIDER=mock
PUBLIC_BASE_URL=http://127.0.0.1:8000
SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_ENVIRONMENT=sandbox

# Docker / Postgres / Redis / Celery
# (docker-compose.dev.yml force déjà ces valeurs dans les containers)
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=gabevent
# POSTGRES_USER=gabevent
# POSTGRES_PASSWORD=devpassword123
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# Préfixe fallback (chaque événement le choisit dans ses paramètres, ex. GAE26)
# RECIPIENT_CODE_PREFIX=GAE26
VIP_CODE_PREFIX=VIP

# E-mail — récupération de mot de passe (console en local si EMAIL_HOST est vide)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Gab Event <noreply@votre-domaine.com>

# Fallback affichage (si aucun Event)
CEREMONY_TITLE=Gab Event
CEREMONY_SUBTITLE=Invitations événementielles
CEREMONY_DATE=
CEREMONY_TIME=
CEREMONY_VENUE=
CEREMONY_ORGANIZER=Gab Event
