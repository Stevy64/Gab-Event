# Modèle du Secret du namespace gabevent.
# Sur le VPS : /etc/gabevent/app.env, mode 600. Ne pas commiter le fichier rempli.
# Générer la clé : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Le site public est gabevent.gabomazone.com.
# localhost et 127.0.0.1 servent aux sondes du pod. L'Ingress n'envoie que le nom public.
# Postgres est celui du namespace donnees. Gab Event lit POSTGRES_*, pas une URL.
# Redis reste dans le namespace, sans Ingress. Celery s'en sert comme courtier.

DJANGO_SETTINGS_MODULE=config.settings
DEBUG=0
SECRET_KEY=remplacer-par-secrets.token_urlsafe-48
ALLOWED_HOSTS=gabevent.gabomazone.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://gabevent.gabomazone.com
PUBLIC_BASE_URL=https://gabevent.gabomazone.com
BEHIND_PROXY=1
ALLOW_MOCK_PAYMENTS=0
POSTGRES_HOST=postgres.donnees.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=gabevent
POSTGRES_USER=gabevent
POSTGRES_PASSWORD=remplacer-par-le-mot-de-passe-de-la-base
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Billetterie : identifiants SingPay de production, puis recréer le Secret.
# SINGPAY_API_KEY=
# SINGPAY_API_SECRET=
# SINGPAY_MERCHANT_ID=
# SINGPAY_DISBURSEMENT_ID=
# SINGPAY_ENVIRONMENT=production
# Le webhook est https://gabevent.gabomazone.com/payments/webhook/singpay/

# Mot de passe oublié. Sans EMAIL_HOST, Django écrit le message dans les journaux.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Gab Event <no-reply@gabomazone.com>
