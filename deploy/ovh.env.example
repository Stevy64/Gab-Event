# Copiez vers /opt/gab-event/.env sur le VPS OVH (ne jamais committer).

SECRET_KEY=remplacez-par-une-cle-longue-et-aleatoire
DEBUG=False
ALLOWED_HOSTS=votredomaine.com,www.votredomaine.com
CSRF_TRUSTED_ORIGINS=https://votredomaine.com,https://www.votredomaine.com
PUBLIC_BASE_URL=https://votredomaine.com
BEHIND_PROXY=1
SECURE_SSL=1

POSTGRES_DB=gabevent
POSTGRES_USER=gabevent
POSTGRES_PASSWORD=mot-de-passe-postgres-fort
POSTGRES_HOST=gabevent-db
POSTGRES_PORT=5432

ALLOW_MOCK_PAYMENTS=False
PAYMENT_PROVIDER=singpay
SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_ENVIRONMENT=prod

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Gab Event <noreply@votredomaine.com>
